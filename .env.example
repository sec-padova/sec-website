# Browser-safe values from the Supabase project Connect panel.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Opt in only when serving a local test preview through the restricted Vite proxy.
# Production builds always ignore this flag.
VITE_LOCAL_PREVIEW=false
